#!/usr/bin/env bash
# helix-herdr — open a registered tool (gitui, scooter, yazi, ...) in a
# dedicated herdr pane, split to the right of the current (Helix) pane.
#
# The tool name, pane title, process check, and launch command are all per-tool
# registry entries instead of hard-coded.
#
# Designed to be bound to Helix keys, e.g.:
#   [keys.normal.space.g]
#   g = { label = "GitUI", command = [":write-all", ":sh helix-herdr gitui", ":redraw"] }
#   G = { label = "GitUI at Line", command = [":noop %sh{helix-herdr gitui $(git blame -L %{cursor_line},%{cursor_line} --porcelain '%{file_path_absolute}' | head -1 | cut -d' ' -f1)}"] }
#   f = { label = "Files (yazi)", command = [":write-all", ":sh helix-herdr yazi", ":redraw"] }
#   s = { label = "Scooter", command = [":write-all", ":sh helix-herdr scooter", ":redraw"] }
#
# Subcommands:
#   helix-herdr <tool> [args...]  open <tool> in a herdr pane split right
#   helix-herdr <tool> --close    close <tool>'s pane
#   helix-herdr --list            list registered tools
#   helix-herdr --help            show usage
#
# Behavior (per tool):
#   - reuses an existing <tool> herdr pane in the current tab (state file +
#     title scan + process check)
#   - creates one (splits the current pane right, ratio 0.5, focused) if missing
#   - launches <tool> in that pane and focuses it (all current tools are
#     interactive); optional args (e.g. a git hash for gitui) are forwarded
#   - routes GitUI's changed-file editor back to the originating Helix pane,
#     then closes the GitUI pane; Git metadata editors remain blocking `hx`
#
# NOTE on directions: herdr's `pane split --direction` only supports `right`
# and `down`. By design this script always splits right; `--side`/`--right`
# are accepted for CLI clarity but behave identically to the default.
set -u

STATE_DIR="$HOME/.local/state"
mkdir -p "$STATE_DIR"

die() { echo "helix-herdr: $*" >&2; exit 1; }
usage() {
  cat <<'EOF'
usage: helix-herdr <tool> [args...]
       helix-herdr <tool> --close
       helix-herdr --list
       helix-herdr --help

Open a registered tool (gitui, scooter, yazi) in a dedicated herdr pane split
to the right of the current pane, reusing an existing pane for that tool when
present. '--close' closes the tool's pane. Tools run with the pane focused.
EOF
}

# --- per-tool registry -----------------------------------------------------
# Each tool is a case arm assigning:
#   TITLE   pane rename title (also names the state file)
#   PROG    process name to detect as "running" via `process-info`
#   FOCUS   "yes" = new pane takes focus (interactive TUI), "" = background
# Then CMD is built from $args (lowercased-passthrough) + optional reaping.
tool_meta() {
  case "$1" in
    gitui)
      TITLE="gitui"; PROG="gitui"; FOCUS="yes"
      # optional first arg = commit hash to jump to
      CMD=(gitui "${args[@]}")
      ;;
    scooter)
      TITLE="scooter"; PROG="scooter"; FOCUS="yes"
      CMD=(scooter "${args[@]}")
      ;;
    yazi)
      TITLE="yazi"; PROG="yazi"; FOCUS="yes"
      CMD=(yazi "${args[@]}")
      ;;
    *)
      return 1
      ;;
  esac
}

# Is PROG the foreground process of pane $1?
tool_running() {
  herdr pane process-info --pane "$1" 2>/dev/null | grep -aq "$PROG"
}

# Shell-quote each arg and join with spaces, so the reconstructed command line
# round-trips through `herdr pane run`'s shell with spaces/special chars intact.
quote_cmd() {
  local out="" a
  for a in "$@"; do
    out+=" '${a//\'/\'\\\'\'}'"
  done
  printf '%s' "${out# }"
}

# Focus target pane $2 relative to source pane $1. Herdr focuses by direction,
# so derive that direction from the tab's live layout instead of relying on the
# UI's implicit post-close focus choice.
focus_pane_from() {
  local source="$1" target="$2" direction
  direction="$(herdr pane layout --pane "$source" 2>/dev/null | python3 -c '
import json, sys
source, target = sys.argv[1:3]
try:
    layout = json.load(sys.stdin)["result"]["layout"]
    panes = {pane["pane_id"]: pane["rect"] for pane in layout["panes"]}
    current = panes[source]
    destination = panes[target]
    if destination["x"] > current["x"]: print("right")
    elif destination["x"] < current["x"]: print("left")
    elif destination["y"] > current["y"]: print("down")
    elif destination["y"] < current["y"]: print("up")
except Exception:
    pass
' "$source" "$target")"

  case "$direction" in
    left|right|up|down)
      herdr pane focus --pane "$source" --direction "$direction"
      ;;
    *)
      return 1
      ;;
  esac
}

# GitUI launches its configured editor as a blocking child process. For normal
# worktree files, route that open back to the Helix pane that launched GitUI and
# close GitUI's temporary pane. Git metadata files must keep the normal blocking
# editor behavior because GitUI reads them only after the editor exits.
open_in_helix() {
  local target="${HELIX_HERDR_PANE:-}"
  local current="${HELIX_HERDR_TOOL_PANE:-${HERDR_PANE_ID:-}}"
  local arg base command=":open"

  [ "$#" -gt 0 ] || die "--edit requires a file"

  for arg in "$@"; do
    base="${arg##*/}"
    case "$base" in
      COMMIT_EDITMSG|MERGE_MSG|TAG_EDITMSG|git-rebase-todo)
        exec hx "$@"
        ;;
    esac
  done

  # If this was invoked outside the managed GitUI pane, retain the user's
  # configured editor behavior instead of swallowing the open request.
  if [ -z "$target" ] || [ -z "$current" ] \
    || ! herdr pane get "$target" >/dev/null 2>&1; then
    exec hx "$@"
  fi

  # Helix command-line arguments use doubled single quotes inside a quoted
  # argument. This safely preserves spaces, percent signs, and apostrophes.
  for arg in "$@"; do
    command+=" '${arg//\'/\'\'}'"
  done

  herdr pane send-keys "$target" esc >/dev/null 2>&1 \
    || exec hx "$@"
  herdr pane send-text "$target" "$command" >/dev/null 2>&1 \
    || exec hx "$@"
  herdr pane send-keys "$target" enter >/dev/null 2>&1 \
    || exec hx "$@"

  # Closing the GitUI pane alone can leave Helix's terminal-focus flag false:
  # input still arrives, but Helix deliberately suppresses its primary cursor.
  # Explicit focus emits FocusGained and redraws the cursor before the close.
  focus_pane_from "$current" "$target" >/dev/null 2>&1 || true

  # Clear only this pane's state entry before closing it.
  local state="$STATE_DIR/helix-herdr-gitui.pane"
  if [ -f "$state" ] && [ "$(cat "$state")" = "$current" ]; then
    rm -f "$state"
  fi
  herdr pane close "$current" >/dev/null 2>&1 || true
  exit 0
}

# --- no-arg / dispatch -----------------------------------------------------
if [ "$#" -eq 0 ]; then usage; exit 1; fi

if [ "$1" = "--edit" ]; then
  shift
  open_in_helix "$@"
fi

case "$1" in
  --help|-h) usage; exit 0 ;;
  --list)
    echo "registered tools:"
    echo "  gitui    git TUI (optional arg: commit hash)"
    echo "  scooter  interactive find & replace TUI"
    echo "  yazi     file manager TUI"
    exit 0
    ;;
esac

TOOL="$1"; shift

# `--side`/`--right` accepted (right split is the only behavior); normalize away.
case "${1:-}" in
  --side|--right) shift ;;
esac

# --- per-tool close mode ---------------------------------------------------
if [ "${1:-}" = "--close" ]; then
  ST="$STATE_DIR/helix-herdr-$TOOL.pane"
  if [ -f "$ST" ]; then
    herdr pane close "$(cat "$ST")" >/dev/null 2>&1
    rm -f "$ST"
  fi
  exit 0
fi

# Remaining args are forwarded to the tool.
args=("$@")
tool_meta "$TOOL" || die "unknown tool: '$TOOL' (try 'helix-herdr --list')"

ST="$STATE_DIR/helix-herdr-$TOOL.pane"

# --- current pane + its tab (the helix pane invoking this script) ---------
CUR_PID="$(herdr pane current 2>/dev/null | python3 -c "
import json, sys
try:
    print(json.load(sys.stdin)['result']['pane']['pane_id'])
except Exception:
    pass
")"
CUR_TAB="$(herdr pane current 2>/dev/null | python3 -c "
import json, sys
try:
    print(json.load(sys.stdin)['result']['pane']['tab_id'])
except Exception:
    pass
")"
[ -n "$CUR_TAB" ] || die "could not resolve current tab"
[ -n "$CUR_PID" ] || die "could not resolve current pane"

# tab_id of pane $1 (empty if it no longer exists)
pane_tab() {
  herdr pane get "$1" 2>/dev/null | python3 -c "
import json, sys
try:
    print(json.load(sys.stdin)['result']['pane']['tab_id'])
except Exception:
    pass
"
}

# --- resolve pane id (reuse an existing running <tool> pane in THIS tab) ---
PID=""
if [ -f "$ST" ]; then
  CAND="$(cat "$ST")"
  if [ "$(pane_tab "$CAND")" = "$CUR_TAB" ] && tool_running "$CAND"; then
    PID="$CAND"
  fi
fi
if [ -z "$PID" ]; then
  PID="$(herdr pane list 2>/dev/null | python3 -c "
import json, sys
cur_tab = '$CUR_TAB'
title = '$TITLE'
try:
    d = json.load(sys.stdin)
    for p in d['result']['panes']:
        if p.get('tab_id') != cur_tab:
            continue
        t = p.get('terminal_title_stripped') or ''
        if title in t:
            print(p['pane_id']); break
except Exception:
    pass
")"
  if [ -z "$PID" ]; then PID=""; fi
  if [ -n "$PID" ] && ! tool_running "$PID"; then
    herdr pane close "$PID" >/dev/null 2>&1
    PID=""
  fi
fi

# --- create if missing -----------------------------------------------------
if [ -z "$PID" ]; then
  SPLIT_FOCUS=""
  [ "$FOCUS" = "yes" ] && SPLIT_FOCUS="--focus"
  OUT="$(herdr pane split --current --direction right --ratio 0.5 $SPLIT_FOCUS 2>/dev/null)" \
    || die "herdr pane split failed"
  PID="$(printf '%s' "$OUT" | python3 -c "
import json, sys
try:
    print(json.load(sys.stdin)['result']['pane']['pane_id'])
except Exception:
    pass
")"
  [ -n "$PID" ] || die "could not parse new pane id: $OUT"
  herdr pane rename "$PID" "$TITLE" >/dev/null 2>&1
  # GitUI normally resolves core.editor=hx and therefore opens a second Helix
  # in its own pane. Override only this GitUI process so changed files are sent
  # back to the Helix pane that invoked the launcher. The internal editor mode
  # falls back to blocking hx for Git metadata such as COMMIT_EDITMSG.
  if [ "$TOOL" = "gitui" ]; then
    CMD=(env "HELIX_HERDR_PANE=$CUR_PID" \
      "HELIX_HERDR_TOOL_PANE=$PID" \
      "GIT_EDITOR=helix-herdr --edit" "${CMD[@]}")
  fi
  # `; exit` closes the pane when the tool quits (herdr reaps ended processes).
  # Quote each element so args containing spaces (e.g. scooter --search-text
  # with yanked multi-word text) survive the pane's shell unbroken.
  RUN="$(quote_cmd "${CMD[@]}")"
  herdr pane run "$PID" "$RUN; exit" >/dev/null 2>&1 || die "pane run failed on $PID"
  sleep 0.7
else
  # Reuse: bring focus back onto the existing <tool> pane.
  focus_pane_from "$CUR_PID" "$PID" >/dev/null 2>&1 || true
fi

echo "$PID" > "$ST"
