#!/usr/bin/env bash
# helix-rex — open a registered tool (lazygit, scooter, yazi) in a Rex pane
# split to the right of the current (Helix) pane.
#
# Bind it to Helix keys, e.g.:
#   g = { label = "LazyGit", command = [":write-all", ":sh helix-rex lazygit", ":redraw"] }
#   G = { label = "LazyGit on Blamed Commit", command = [":write", ":sh helix-rex lazygit --blame '%{file_path_absolute}' %{cursor_line}", ":redraw"] }
#
# Subcommands:
#   helix-rex <tool> [args...]  open <tool> in a pane split right
#   helix-rex lazygit --blame <file> <line>  open LazyGit on the files of the commit blamed for that line
#   helix-rex <tool> --close    close <tool>'s pane
#   helix-rex --list            list registered tools
#   helix-rex --help            show usage
#
# Behavior (per tool):
#   - reuses an existing <tool> pane in the current Rex tab (state file,
#     label scan, process check) and focuses it
#   - otherwise splits the current pane right (50%, focused) and runs <tool>;
#     the pane closes when the tool exits; args are forwarded
#   - LazyGit's file editor is routed back to the originating Helix pane, then
#     the LazyGit pane closes; Git metadata files still open in blocking `hx`
#
# Rex splits any direction, but this script always splits right. `--side` and
# `--right` are accepted and ignored. Rex targets $REX_SESSION, so no -s flags.
set -u

STATE_DIR="$HOME/.local/state"
mkdir -p "$STATE_DIR"

die() { echo "helix-rex: $*" >&2; exit 1; }
usage() {
  cat <<'EOF'
usage: helix-rex <tool> [args...]
       helix-rex lazygit --blame <file> <line>
       helix-rex <tool> --close
       helix-rex --list
       helix-rex --help

Open a registered tool (lazygit, scooter, yazi) in a dedicated Rex pane split
to the right of the current pane, reusing an existing pane for that tool when
present. '--close' closes the tool's pane. Tools run with the pane focused.
'lazygit --blame' opens the files of the commit that last touched <line>.
EOF
}

# The rex next to the running server matches its protocol; PATH may not.
REX_BIN="rex"
if [ -x "${REX_BIN_DIR:-}/rex" ]; then REX_BIN="$REX_BIN_DIR/rex"; fi
rex() { "$REX_BIN" "$@"; }

# --- per-tool registry -----------------------------------------------------
# Each tool is a case arm assigning:
#   TITLE   pane label (also names the state file)
#   PROG    foreground process name that means "running"
#   FOCUS   "yes" = new pane takes focus (interactive TUI), "" = background
#   CMD     launch command built from $args
# ${args[@]+...} keeps empty args safe under `set -u` on bash 3.2.
tool_meta() {
  case "$1" in
    lazygit)
      TITLE="lazygit"; PROG="lazygit"; FOCUS="yes"
      CMD=(lazygit ${args[@]+"${args[@]}"})
      ;;
    scooter)
      TITLE="scooter"; PROG="scooter"; FOCUS="yes"
      CMD=(scooter ${args[@]+"${args[@]}"})
      ;;
    yazi)
      TITLE="yazi"; PROG="yazi"; FOCUS="yes"
      CMD=(yazi ${args[@]+"${args[@]}"})
      ;;
    *)
      return 1
      ;;
  esac
}

# Is PROG the foreground process of pane $1?
tool_running() {
  rex block call -b "$1" process 2>/dev/null \
    | jq -e --arg p "$PROG" '
        .foreground
        | [.name, (.path // "" | split("/")[-1]), (.invoked_path // "" | split("/")[-1])]
        | any(. == $p)' >/dev/null 2>&1
}

# Rex tab (window) id of pane $1; empty if the pane is gone.
pane_tab() {
  rex block ls --json 2>/dev/null \
    | jq -r --arg id "$1" '.blocks[] | select(.block_id == $id) | .window_id' 2>/dev/null
}

# LazyGit runs its editor as a blocking child. Send worktree files back to the
# Helix pane that launched LazyGit, then close the LazyGit pane.
open_in_helix() {
  local target="${HELIX_REX_PANE:-}"
  local current="${HELIX_REX_TOOL_PANE:-${REX_BLOCK:-}}"
  local arg base command=":open" q="'"

  [ "$#" -gt 0 ] || die "--edit requires a file"

  # Git reads these only after the editor exits, so they must block.
  for arg in "$@"; do
    base="${arg##*/}"
    case "$base" in
      COMMIT_EDITMSG|MERGE_MSG|TAG_EDITMSG|git-rebase-todo)
        exec hx "$@"
        ;;
    esac
  done

  # Outside a managed LazyGit pane, keep the normal editor behavior.
  if [ -z "$target" ] || [ -z "$current" ] \
    || [ -z "$(pane_tab "$target")" ]; then
    exec hx "$@"
  fi

  # Helix escapes a single quote inside a quoted argument by doubling it.
  for arg in "$@"; do
    command+=" '${arg//$q/$q$q}'"
  done

  rex send-key -b "$target" esc >/dev/null 2>&1 \
    || exec hx "$@"
  rex send -b "$target" "$command" >/dev/null 2>&1 \
    || exec hx "$@"
  rex send-key -b "$target" enter >/dev/null 2>&1 \
    || exec hx "$@"

  # Closing alone can leave Helix without terminal focus and hide its cursor.
  rex focus "$target" >/dev/null 2>&1 || true

  local state="$STATE_DIR/helix-rex-lazygit.pane"
  if [ -f "$state" ] && [ "$(cat "$state")" = "$current" ]; then
    rm -f "$state"
  fi
  rex block close "$current" >/dev/null 2>&1 || true
  exit 0
}

# --- lazygit --blame helpers ------------------------------------------------
# LazyGit has no CLI arg for a commit, so we type /<sha> into its commits panel.
pane_screen() { rex capture -b "$1" 2>/dev/null; }

# Keys sent before LazyGit's first render are lost, so wait for HEAD's hash.
wait_for_commit_list() {
  local pane="$1" head7="$2"
  for _ in $(seq 1 100); do
    case "$(pane_screen "$pane")" in *"$head7"*) return 0 ;; esac
    sleep 0.025
  done
  return 1
}

# Search for <sha> in pane $1's commits panel, confirm the cursor landed, open its files.
jump_to_commit() {
  local pane="$1" sha="$2" screen last
  rex send -b "$pane" "/$sha" >/dev/null 2>&1 || return 1
  rex send-key -b "$pane" enter >/dev/null 2>&1 || return 1
  for _ in $(seq 1 30); do
    screen="$(pane_screen "$pane")"
    case "$screen" in
      *"commit $sha"*)
        # Enter works with the search bar still on; skip it unless the cursor is verified.
        rex send-key -b "$pane" enter >/dev/null 2>&1
        return 0
        ;;
    esac
    last="$(printf '%s\n' "$screen" | sed '/^[[:space:]]*$/d' | tail -n 1)"
    # Only 300 commits load first; older ones need `n`, which is "new branch" outside search.
    case "$last" in *"Search: matches for"*) rex send -b "$pane" n >/dev/null 2>&1 ;; esac
    sleep 0.1
  done
  return 1
}

# Raw keys once typed "/<sha>" into a commit prompt, so Esc out and refocus commits.
reuse_jump() {
  local pane="$1" sha="$2"
  rex send-key -b "$pane" esc >/dev/null 2>&1; sleep 0.1
  rex send-key -b "$pane" esc >/dev/null 2>&1; sleep 0.1
  rex send -b "$pane" 4 >/dev/null 2>&1; sleep 0.05
  # A files view left open would swallow the search, so pop back to the list.
  rex send-key -b "$pane" esc >/dev/null 2>&1; sleep 0.1
  jump_to_commit "$pane" "$sha"
}

# Is the foreground cwd of pane $1 inside repo $2?
pane_in_repo() {
  local cwd
  cwd="$(rex block call -b "$1" process 2>/dev/null | jq -r '.foreground.cwd // empty')"
  [ -n "$cwd" ] && [ "$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" = "$2" ]
}

# --- dispatch --------------------------------------------------------------
if [ "$#" -eq 0 ]; then usage; exit 1; fi

if [ "$1" = "--edit" ]; then
  shift
  open_in_helix "$@"
fi

case "$1" in
  --help|-h) usage; exit 0 ;;
  --list)
    echo "registered tools:"
    echo "  lazygit  git TUI (optional args: panel to focus, --filter <path>, or --blame <file> <line>)"
    echo "  scooter  interactive find & replace TUI"
    echo "  yazi     file manager TUI"
    exit 0
    ;;
esac

TOOL="$1"; shift

case "${1:-}" in
  --side|--right) shift ;;
esac

command -v "$REX_BIN" >/dev/null 2>&1 || die "rex not found"
command -v jq >/dev/null 2>&1 || die "jq not found"

# --- close mode ------------------------------------------------------------
if [ "${1:-}" = "--close" ]; then
  ST="$STATE_DIR/helix-rex-$TOOL.pane"
  if [ -f "$ST" ]; then
    rex block close "$(cat "$ST")" >/dev/null 2>&1
    rm -f "$ST"
  fi
  exit 0
fi

# --- lazygit --blame <file> <line> -------------------------------------------
COMMIT=""; REPO=""; HEAD7=""
if [ "$TOOL" = "lazygit" ] && [ "${1:-}" = "--blame" ]; then
  [ "$#" -ge 3 ] || die "--blame needs FILE and LINE"
  BFILE="$2"; BLINE="$3"; shift 3
  BDIR="$(dirname "$BFILE")"
  REPO="$(git -C "$BDIR" rev-parse --show-toplevel 2>/dev/null)" || die "not in a git repo: $BFILE"
  COMMIT="$(git -C "$BDIR" blame -L "$BLINE,$BLINE" --porcelain -- "$BFILE" 2>/dev/null | head -n 1 | cut -d' ' -f1)"
  case "$COMMIT" in
    0000000000000000000000000000000000000000) echo "helix-rex: line $BLINE is not committed yet" >&2; COMMIT="" ;;
    *[!0-9a-f]*|"") echo "helix-rex: no blame for $BFILE:$BLINE" >&2; COMMIT="" ;;
  esac
  HEAD7="$(git -C "$REPO" rev-parse HEAD 2>/dev/null | cut -c1-7)"
  [ -n "$HEAD7" ] || COMMIT=""
  # `log` focuses the commits panel; `-sm normal` keeps the layout the jump checks rely on.
  set -- log -sm normal "$@"
fi

args=("$@")
tool_meta "$TOOL" || die "unknown tool: '$TOOL' (try 'helix-rex --list')"

ST="$STATE_DIR/helix-rex-$TOOL.pane"

# --- current pane and tab (the Helix pane invoking this script) ------------
CUR_PID="${REX_BLOCK:-}"
[ -n "$CUR_PID" ] || die "could not resolve current pane (not inside Rex?)"
CUR_TAB="$(pane_tab "$CUR_PID")"
[ -n "$CUR_TAB" ] || die "could not resolve current tab"

# --- reuse a running <tool> pane in THIS tab -------------------------------
PID=""
if [ -f "$ST" ]; then
  CAND="$(cat "$ST")"
  if [ "$(pane_tab "$CAND")" = "$CUR_TAB" ] && tool_running "$CAND"; then
    PID="$CAND"
  fi
fi
if [ -z "$PID" ]; then
  PID="$(rex block ls --json 2>/dev/null \
    | jq -r --arg tab "$CUR_TAB" --arg label "$TITLE" '
        [.blocks[] | select(.window_id == $tab and .label == $label)][0].block_id // empty' 2>/dev/null)"
  # A labeled pane without the tool is stale.
  if [ -n "$PID" ] && ! tool_running "$PID"; then
    rex block close "$PID" >/dev/null 2>&1
    PID=""
  fi
fi

# A pane in another repo can't be reused for a blame jump.
if [ -n "$PID" ] && [ -n "$REPO" ] && ! pane_in_repo "$PID" "$REPO"; then
  rex block close "$PID" >/dev/null 2>&1
  PID=""
fi

# --- create if missing -----------------------------------------------------
if [ -z "$PID" ]; then
  SPLIT_FOCUS="--focus=false"
  [ "$FOCUS" = "yes" ] && SPLIT_FOCUS="--focus=true"
  # Scope the Helix editor to this LazyGit only: the overlay config covers
  # file edits and GIT_EDITOR covers commit messages. The new pane's own
  # REX_BLOCK serves as HELIX_REX_TOOL_PANE.
  if [ "$TOOL" = "lazygit" ]; then
    LG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lazygit"
    CMD=(env "HELIX_REX_PANE=$CUR_PID" "GIT_EDITOR=helix-rex --edit" \
      "LG_CONFIG_FILE=$LG_DIR/config.yml,$LG_DIR/helix-rex.yml" "${CMD[@]}")
  fi
  # Rex runs the command directly, so args with spaces or quotes stay intact.
  OUT="$(rex split -b "$CUR_PID" --split=right --ratio 50 "$SPLIT_FOCUS" \
    --label "$TITLE" -c "${REPO:-$PWD}" --json -- "${CMD[@]}" 2>&1)" \
    || die "rex split failed: $OUT"
  PID="$(printf '%s' "$OUT" | jq -r '.block_ids[0] // empty' 2>/dev/null)"
  [ -n "$PID" ] || die "could not parse new pane id: $OUT"
  echo "$PID" > "$ST"
  [ -z "$COMMIT" ] || { wait_for_commit_list "$PID" "$HEAD7" && jump_to_commit "$PID" "$COMMIT"; } || echo "helix-rex: could not select $COMMIT" >&2
else
  rex focus "$PID" >/dev/null 2>&1 || true
  echo "$PID" > "$ST"
  [ -z "$COMMIT" ] || reuse_jump "$PID" "$COMMIT" || echo "helix-rex: could not select $COMMIT" >&2
fi
