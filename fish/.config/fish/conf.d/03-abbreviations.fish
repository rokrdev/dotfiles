# Git
abbr -a gt git
abbr -a gts git status
abbr -a gtch git checkout
abbr -a gtd git diff
abbr -a gtds git diff --staged
abbr -a gtpa git pull
abbr -a gtpu git push

# Tools
abbr -a h hx
abbr -a v hx
abbr -a yz yazi
abbr -a zz zi

# Extended Navigation
abbr -a .. 'cd ..'
abbr -a ... 'cd ../../'
abbr -a .... 'cd ../../../'
abbr -a ..... 'cd ../../../../'
abbr -a ...... 'cd ../../../../../'
abbr -a ....... 'cd ../../../../../../'

abbr -a py python
abbr -a pn pnpm

abbr -a d 'cd ~/.dotfiles'
abbr -a dkcu 'docker compose up'
abbr -a dkcd 'docker compose down'
abbr -a dkcs 'docker compose start'
abbr -a dkcp 'docker compose stop'
abbr -a gtp 'git pull origin (git branch --show-current)'
abbr -a gg gitui
abbr -a gtl 'git log --oneline --graph --decorate --all'
abbr -a gtx 'git clean -fxd'
abbr -a kbgp "kubectl get pods"
abbr -a kbl "kubectl logs"
abbr -a kblf "kubectl logs -f"
abbr -a lg lazygit
abbr -a sf 'source $FISH_CONFIG'
abbr -a st speedtest-cli
abbr -a top btop
