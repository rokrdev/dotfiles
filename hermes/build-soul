#!/usr/bin/env python3
"""Build a Hermes profile SOUL.md from a soul fragment and marked AGENTS.md sections.

usage: build-soul [--agents PATH] <profile-home> <fragment> <section>...
"""
from __future__ import annotations

import argparse
import os
import re
import sys
import tempfile
from pathlib import Path

DEFAULT_AGENTS = Path.home() / ".dotfiles/agents/AGENTS.md"
# Hermes truncates SOUL.md at 20,000 chars. Fail early so nothing is cut silently.
MAX_CHARS = 19_000

OPEN_RE = re.compile(r"^<!-- section:([A-Za-z0-9_-]+) -->\s*$")
CLOSE_RE = re.compile(r"^<!-- /section:([A-Za-z0-9_-]+) -->\s*$")


class BuildError(Exception):
    pass


def parse_sections(path: Path) -> dict[str, str]:
    sections: dict[str, str] = {}
    current: str | None = None
    buf: list[str] = []
    for lineno, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        opened = OPEN_RE.match(line)
        closed = CLOSE_RE.match(line)
        if opened:
            if current is not None:
                raise BuildError(f"{path}:{lineno}: section '{opened[1]}' opens inside '{current}'")
            if opened[1] in sections:
                raise BuildError(f"{path}:{lineno}: duplicate section '{opened[1]}'")
            current, buf = opened[1], []
        elif closed:
            if closed[1] != current:
                raise BuildError(f"{path}:{lineno}: unexpected close of '{closed[1]}'")
            sections[current] = "\n".join(buf).strip()
            current = None
        elif current is not None:
            buf.append(line)
    if current is not None:
        raise BuildError(f"{path}: section '{current}' is never closed")
    return sections


def write_atomic(target: Path, text: str) -> None:
    mode = target.stat().st_mode & 0o777 if target.exists() else 0o644
    fd, tmp = tempfile.mkstemp(dir=target.parent, prefix=".SOUL.md.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, target)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def build(profile_home: Path, fragment: Path, names: list[str], agents: Path) -> tuple[Path, int]:
    if not profile_home.is_dir():
        raise BuildError(f"profile home is not a directory: {profile_home}")
    if not fragment.is_file():
        raise BuildError(f"fragment not found: {fragment}")
    if not agents.is_file():
        raise BuildError(f"AGENTS.md not found: {agents}")
    if len(set(names)) != len(names):
        raise BuildError("a section was requested more than once")

    available = parse_sections(agents)
    missing = [n for n in names if n not in available]
    if missing:
        raise BuildError(
            f"missing section(s) in {agents}: {', '.join(missing)} "
            f"(available: {', '.join(sorted(available)) or 'none'})"
        )

    parts = [fragment.read_text(encoding="utf-8").strip(), *(available[n] for n in names)]
    empty = [n for n, p in zip(["fragment", *names], parts) if not p]
    if empty:
        raise BuildError(f"empty content: {', '.join(empty)}")
    text = "\n\n".join(parts) + "\n"
    if len(text) > MAX_CHARS:
        raise BuildError(f"output is {len(text)} chars, limit is {MAX_CHARS}; nothing written")

    target = profile_home / "SOUL.md"
    write_atomic(target, text)
    return target, len(text)


def main() -> int:
    ap = argparse.ArgumentParser(prog="build-soul", description=__doc__.split("\n\n")[0])
    ap.add_argument("--agents", type=Path, default=DEFAULT_AGENTS, help="AGENTS.md with section markers")
    ap.add_argument("profile_home", type=Path)
    ap.add_argument("fragment", type=Path)
    ap.add_argument("sections", nargs="+")
    args = ap.parse_args()
    try:
        target, chars = build(args.profile_home.expanduser(), args.fragment.expanduser(), args.sections,
                              args.agents.expanduser())
    except BuildError as e:
        print(f"build-soul: {e}", file=sys.stderr)
        return 1
    print(f"wrote {target}: {chars} chars, parts: {args.fragment.name} + {', '.join(args.sections)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
